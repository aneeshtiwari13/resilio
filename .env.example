# ==============================================================================
# RESILIO — Environment Configuration Template (.env.example)
# Copy this file to .env and customize for your local environment.
# NEVER commit production passwords, tokens, or credentials to version control.
# ==============================================================================

# Application Workload Configuration
APP_NAME=resilio-demo-app
APP_VERSION=1.0.0
APP_PORT=8080
APP_ENVIRONMENT=production

# Source Code Management (GitHub)
GITHUB_REPO_URL=https://github.com/your-org/resilio.git
GITHUB_BRANCH=main
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Jenkins Automation Configuration
JENKINS_HOST_PORT=8085
JENKINS_AGENT_PORT=50000
JENKINS_URL=http://localhost:8085
JENKINS_USER=admin
JENKINS_API_TOKEN=your_jenkins_api_token_here
JENKINS_JOB_NAME=resilio-pipeline

# Docker & Container Engine
DOCKER_IMAGE_NAME=resilio/demo-app
DOCKER_NETWORK=resilio_net

# Selenium Automated Testing Grid
SELENIUM_GRID_URL=http://localhost:4444/wd/hub
TARGET_BASE_URL=http://resilio-demo-app:8080

# Control Plane Database (PostgreSQL)
POSTGRES_DB=resilio
POSTGRES_USER=resilio_user
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_PORT=5432

# Resilio Dashboard & Backend API
RESILIO_BACKEND_PORT=8090
RESILIO_FRONTEND_PORT=3000
RESILIO_API_URL=http://localhost:8090

# Phase 3 Security & Access Control
ADMIN_INITIAL_PASSWORD=replace_with_strong_admin_password
OPERATOR_INITIAL_PASSWORD=replace_with_strong_operator_password
VIEWER_INITIAL_PASSWORD=replace_with_strong_viewer_password

# Phase 3 Distributed Recovery & Leasing
RESILIO_RECOVERY_LEASE_DURATION_SECONDS=60
RESILIO_AUTO_RECONCILE_ON_STARTUP=true
