{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Run Backend Server (Spring Boot)",
      "type": "shell",
      "command": ".\\mvnw.cmd spring-boot:run",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "2. Run Backend Tests (Maven)",
      "type": "shell",
      "command": ".\\mvnw.cmd test",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "3. Run Phase 2 & 3 Scenarios Test (PowerShell)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts\\test_phase2_scenarios.ps1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "4. Package Backend JAR",
      "type": "shell",
      "command": ".\\mvnw.cmd package -DskipTests",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
