pipeline {
    agent any

    options {
        timeout(time: 20, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '20'))
        ansiColor('xterm')
    }

    environment {
        APP_NAME = 'resilio-demo-app'
        COMMIT_SHA = "${env.GIT_COMMIT ? env.GIT_COMMIT.take(8) : 'b' + env.BUILD_NUMBER + '-sha'}"
        CANDIDATE_VERSION = "1.1.0"
        BUILD_ID_TAG = "b${env.BUILD_NUMBER}-${env.COMMIT_SHA}"
        IMAGE_NAME = "resilio/demo-app:${BUILD_ID_TAG}"
        RESILIO_API_URL = "${env.RESILIO_API_URL ?: 'http://resilio-backend:8090'}"
        SELENIUM_GRID_URL = "${env.SELENIUM_GRID_URL ?: 'http://selenium-chrome:4444/wd/hub'}"
        NGINX_PROXY_URL = "${env.NGINX_PROXY_URL ?: 'http://nginx-proxy:80'}"
        NETWORK_NAME = "resilio_net"
    }

    stages {
        stage('Stage 1: Checkout') {
            steps {
                echo "=================================================="
                echo " [STAGE 1] SCM Checkout: Fetching repository code"
                echo "=================================================="
                checkout scm
                script {
                    echo "Checked out Commit SHA: ${env.COMMIT_SHA}"
                    echo "Branch: ${env.GIT_BRANCH ?: 'main'}"
                }
            }
        }

        stage('Stage 2: Environment Validation') {
            steps {
                echo "=================================================="
                echo " [STAGE 2] Toolchain & Infrastructure Verification"
                echo "=================================================="
                sh '''
                    echo "Java Runtime:"
                    java -version
                    echo "Docker Daemon & CLI:"
                    docker --version || { echo "ERROR: Docker daemon/CLI unavailable in build agent"; exit 1; }
                    docker info > /dev/null || { echo "ERROR: Unable to communicate with Docker daemon socket"; exit 1; }
                    echo "Build environment validation PASSED."
                '''
            }
        }

        stage('Stage 3: Maven Build & Unit Tests') {
            steps {
                echo "=================================================="
                echo " [STAGE 3] Maven Compilation & Mandatory Unit Tests"
                echo "=================================================="
                dir('demo-app') {
                    sh '''
                        chmod +x ./mvnw
                        ./mvnw clean verify -Dapp.commit-sha=${COMMIT_SHA} -Dapp.build-number=${BUILD_NUMBER}
                    '''
                }
            }
            post {
                always {
                    junit testResults: 'demo-app/target/surefire-reports/*.xml', allowEmptyResults: false
                }
                failure {
                    script {
                        echo "=================================================="
                        echo " CRITICAL: Maven build or unit tests failed!"
                        echo " Reporting failure to Resilio Decision Engine..."
                        echo "=================================================="
                        sh """
                            curl -s -X POST '${RESILIO_API_URL}/api/incidents/report-failure' \
                                -H 'Content-Type: application/json' \
                                -d '{"stageName":"Maven Build & Unit Tests","exitCode":1,"candidateVersion":"${CANDIDATE_VERSION}","jenkinsBuild":"#${BUILD_NUMBER}","rawLogs":"Maven compilation or unit test assertion failure. Check Surefire XML."}' || true
                        """
                    }
                }
            }
        }

        stage('Stage 4: Docker Image Build') {
            steps {
                echo "=================================================="
                echo " [STAGE 4] Building Immutable Docker Image: ${IMAGE_NAME}"
                echo "=================================================="
                dir('demo-app') {
                    sh """
                        docker build -t ${IMAGE_NAME} \
                            --build-arg APP_VERSION=${CANDIDATE_VERSION} \
                            --build-arg APP_COMMIT_SHA=${COMMIT_SHA} \
                            --build-arg APP_BUILD_NUMBER=${BUILD_NUMBER} .
                    """
                }
            }
            post {
                failure {
                    sh """
                        curl -s -X POST '${RESILIO_API_URL}/api/incidents/report-failure' \
                            -H 'Content-Type: application/json' \
                            -d '{"stageName":"Docker Image Build","exitCode":1,"candidateVersion":"${CANDIDATE_VERSION}","jenkinsBuild":"#${BUILD_NUMBER}","rawLogs":"Docker build command exited with failure."}' || true
                    """
                }
            }
        }

        stage('Stage 5: Candidate Deployment') {
            steps {
                echo "=================================================="
                echo " [STAGE 5] Starting Candidate in Inactive Slot & Probing"
                echo "=================================================="
                script {
                    sh "docker network inspect ${NETWORK_NAME} >/dev/null 2>&1 || docker network create ${NETWORK_NAME}"
                    
                    // Fetch inactive slot from Resilio
                    def activeInfo = sh(script: "curl -s ${RESILIO_API_URL}/api/releases/active || echo '{\"inactiveSlot\":\"GREEN\"}'", returnStdout: true).trim()
                    echo "Active environment status: ${activeInfo}"
                    def targetSlot = activeInfo.contains('"inactiveSlot":"BLUE"') ? "BLUE" : "GREEN"
                    def containerPort = targetSlot == "BLUE" ? "8081:8080" : "8082:8080"
                    def candidateHost = targetSlot == "BLUE" ? "demo-app-blue" : "demo-app-green"

                    echo "Starting candidate container in inactive slot: ${targetSlot} (${candidateHost})"
                    sh "docker rm -f ${candidateHost} || true"

                    sh """
                        docker run -d --name ${candidateHost} \
                            --network ${NETWORK_NAME} \
                            -p ${containerPort} \
                            -e APP_VERSION=${CANDIDATE_VERSION} \
                            -e APP_COMMIT_SHA=${COMMIT_SHA} \
                            -e APP_BUILD_NUMBER=${BUILD_NUMBER} \
                            -e APP_ENVIRONMENT=${targetSlot.toLowerCase()} \
                            ${IMAGE_NAME}
                    """

                    echo "Waiting for candidate readiness probe (bounded 60s timeout)..."
                    timeout(time: 60, unit: 'SECONDS') {
                        sh """
                            docker run --rm --network ${NETWORK_NAME} curlimages/curl:latest \
                                --retry 15 --retry-delay 3 --retry-all-errors --fail -s \
                                http://${candidateHost}:8080/actuator/health | grep '"status":"UP"'
                        """
                    }
                    echo "Candidate container ${candidateHost} is UP and healthy."
                }
            }
            post {
                failure {
                    script {
                        echo "DEPLOYMENT FAILED: Candidate failed readiness health check."
                        sh """
                            curl -s -X POST '${RESILIO_API_URL}/api/incidents/report-failure' \
                                -H 'Content-Type: application/json' \
                                -d '{"stageName":"Candidate Readiness Probe","exitCode":1,"candidateVersion":"${CANDIDATE_VERSION}","jenkinsBuild":"#${BUILD_NUMBER}","rawLogs":"Candidate readiness probe timed out after 60s."}' || true
                        """
                    }
                }
            }
        }

        stage('Stage 6: Selenium Functional & Regression Gate') {
            steps {
                echo "=================================================="
                echo " [STAGE 6] Browser Functional & Regression Testing"
                echo "=================================================="
                script {
                    def activeInfo = sh(script: "curl -s ${RESILIO_API_URL}/api/releases/active || echo '{\"inactiveSlot\":\"GREEN\"}'", returnStdout: true).trim()
                    def candidateHost = activeInfo.contains('"inactiveSlot":"BLUE"') ? "demo-app-blue" : "demo-app-green"
                    
                    dir('selenium-tests') {
                        sh """
                            chmod +x ./mvnw
                            ./mvnw test -Dtest=CandidateValidationTest \
                                -Dtarget.base.url=http://${candidateHost}:8080 \
                                -Dselenium.grid.url=${SELENIUM_GRID_URL} \
                                -Dexpected.version=${CANDIDATE_VERSION}
                        """
                    }
                }
            }
            post {
                always {
                    junit testResults: 'selenium-tests/target/surefire-reports/*.xml', allowEmptyResults: false
                    archiveArtifacts artifacts: 'selenium-tests/target/screenshots/*.png', allowEmptyArchive: true
                }
                failure {
                    script {
                        echo "GATE FAILURE: Selenium candidate regression check failed! Rejecting candidate."
                        sh """
                            curl -s -X POST '${RESILIO_API_URL}/api/incidents/report-failure' \
                                -H 'Content-Type: application/json' \
                                -d '{"stageName":"Selenium Functional Tests","exitCode":1,"candidateVersion":"${CANDIDATE_VERSION}","jenkinsBuild":"#${BUILD_NUMBER}","rawLogs":"Selenium browser gate failed. Candidate rejected prior to promotion."}' || true
                        """
                    }
                }
            }
        }

        stage('Stage 7: Blue/Green Traffic Promotion') {
            steps {
                echo "=================================================="
                echo " [STAGE 7] All Quality Gates Verified. Promoting Candidate..."
                echo "=================================================="
                script {
                    sh """
                        curl -s -X POST '${RESILIO_API_URL}/api/releases/promote' \
                            -H 'Content-Type: application/json' \
                            -d '{"versionTag":"${CANDIDATE_VERSION}","commitSha":"${COMMIT_SHA}","imageTag":"${IMAGE_NAME}","jenkinsBuildRef":"#${BUILD_NUMBER}"}'
                    """
                }
            }
        }

        stage('Stage 8: Post-Deployment Verification & Self-Healing') {
            steps {
                echo "=================================================="
                echo " [STAGE 8] Post-Deployment Live Traffic Verification"
                echo "=================================================="
                script {
                    try {
                        echo "Auditing public proxy route at: ${NGINX_PROXY_URL}/actuator/health"
                        sh """
                            docker run --rm --network ${NETWORK_NAME} curlimages/curl:latest \
                                --retry 5 --retry-delay 2 --fail -s \
                                ${NGINX_PROXY_URL}/actuator/health | grep '"status":"UP"'
                        """
                        echo "Live proxy route verification PASSED."
                    } catch (Exception e) {
                        echo "=================================================="
                        echo " CRITICAL POST-DEPLOYMENT FAILURE DETECTED!"
                        echo " Triggering Resilio Self-Healing Automated Rollback..."
                        echo "=================================================="
                        sh """
                            curl -s -X POST '${RESILIO_API_URL}/api/recovery/trigger' \
                                -H 'Content-Type: application/json' \
                                -d '{"reason":"Post-deployment health verification failed on public route.","evidence":"Endpoint ${NGINX_PROXY_URL}/actuator/health failed response checks."}'
                        """
                        error("Post-deployment failure triggered automated rollback to known-good release.")
                    }
                }
            }
        }

        stage('Stage 9: Final Result') {
            steps {
                echo "=================================================="
                echo " [STAGE 9] Release Verified & Active in Production"
                echo " Candidate: ${IMAGE_NAME} active and designated KNOWN-GOOD"
                echo "=================================================="
            }
        }
    }

    post {
        success {
            echo "CI/CD Pipeline executed and verified successfully."
        }
        failure {
            echo "Pipeline run completed with status FAILED. Consult Resilio Incident Center for audit logs."
        }
    }
}
