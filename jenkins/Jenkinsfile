pipeline {
    agent any

    options {
        timeout(time: 15, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '15', artifactNumToKeepStr: '15'))
        ansiColor('xterm')
    }

    environment {
        APP_NAME = 'resilio-demo-app'
        COMMIT_SHA = "${env.GIT_COMMIT ? env.GIT_COMMIT.take(8) : 'build-' + env.BUILD_NUMBER}"
        BUILD_ID_TAG = "b${env.BUILD_NUMBER}-${env.COMMIT_SHA}"
        IMAGE_NAME = "resilio/demo-app:${BUILD_ID_TAG}"
        CONTAINER_NAME = "resilio-candidate-b${env.BUILD_NUMBER}"
        SELENIUM_GRID_URL = "${env.SELENIUM_GRID_URL ?: 'http://selenium-chrome:4444/wd/hub'}"
        NETWORK_NAME = "resilio_net"
    }

    stages {
        stage('Stage 1: Checkout') {
            steps {
                echo "=================================================="
                echo " [STAGE 1] SCM Checkout: Fetching repository code"
                echo "=================================================="
                checkout scm
                script {
                    echo "Checked out Commit SHA: ${env.COMMIT_SHA}"
                    echo "Branch: ${env.GIT_BRANCH ?: 'main'}"
                }
            }
        }

        stage('Stage 2: Environment Validation') {
            steps {
                echo "=================================================="
                echo " [STAGE 2] Toolchain & Infrastructure Verification"
                echo "=================================================="
                sh '''
                    echo "Java Runtime:"
                    java -version
                    echo "Docker Daemon & CLI:"
                    docker --version || { echo "ERROR: Docker daemon/CLI unavailable in build agent"; exit 1; }
                    docker info > /dev/null || { echo "ERROR: Unable to communicate with Docker daemon socket"; exit 1; }
                    echo "Build environment validation PASSED."
                '''
            }
        }

        stage('Stage 3: Maven Build & Unit Tests') {
            steps {
                echo "=================================================="
                echo " [STAGE 3] Maven Compilation & Mandatory Unit Tests"
                echo "=================================================="
                dir('demo-app') {
                    sh '''
                        chmod +x ./mvnw
                        ./mvnw clean verify -Dapp.commit-sha=${COMMIT_SHA} -Dapp.build-number=${BUILD_NUMBER}
                    '''
                }
            }
            post {
                always {
                    junit testResults: 'demo-app/target/surefire-reports/*.xml', allowEmptyResults: false
                }
                failure {
                    echo "=================================================="
                    echo " CRITICAL: Maven build or unit tests failed!"
                    echo " Pipeline halted BEFORE containerization or deploy."
                    echo "=================================================="
                }
            }
        }

        stage('Stage 4: Docker Image Build') {
            steps {
                echo "=================================================="
                echo " [STAGE 4] Building Immutable Docker Image: ${IMAGE_NAME}"
                echo "=================================================="
                dir('demo-app') {
                    sh """
                        docker build -t ${IMAGE_NAME} \
                            --build-arg APP_VERSION=1.0.0 \
                            --build-arg APP_COMMIT_SHA=${COMMIT_SHA} \
                            --build-arg APP_BUILD_NUMBER=${BUILD_NUMBER} .
                    """
                }
            }
        }

        stage('Stage 5: Candidate Deployment') {
            steps {
                echo "=================================================="
                echo " [STAGE 5] Starting Candidate Container & Probing"
                echo "=================================================="
                script {
                    // Ensure shared network exists
                    sh "docker network inspect ${NETWORK_NAME} >/dev/null 2>&1 || docker network create ${NETWORK_NAME}"
                    
                    // Stop any existing container with same name
                    sh "docker rm -f ${CONTAINER_NAME} || true"

                    // Start candidate attached to shared network
                    sh """
                        docker run -d --name ${CONTAINER_NAME} \
                            --network ${NETWORK_NAME} \
                            -e APP_VERSION=1.0.0 \
                            -e APP_COMMIT_SHA=${COMMIT_SHA} \
                            -e APP_BUILD_NUMBER=${BUILD_NUMBER} \
                            -e APP_ENVIRONMENT=candidate \
                            ${IMAGE_NAME}
                    """

                    echo "Waiting for candidate readiness probe (bounded 60s timeout)..."
                    timeout(time: 60, unit: 'SECONDS') {
                        sh """
                            docker run --rm --network ${NETWORK_NAME} curlimages/curl:latest \
                                --retry 15 --retry-delay 3 --retry-all-errors --fail -s \
                                http://${CONTAINER_NAME}:8080/actuator/health | grep '"status":"UP"'
                        """
                    }
                    echo "Candidate container ${CONTAINER_NAME} is UP and responding to health checks."
                }
            }
            post {
                failure {
                    echo "DEPLOYMENT FAILED: Candidate container failed readiness health checks."
                    sh "docker logs ${CONTAINER_NAME} || true"
                }
            }
        }

        stage('Stage 6: Selenium Functional Tests') {
            steps {
                echo "=================================================="
                echo " [STAGE 6] Browser Functional & Regression Testing"
                echo "=================================================="
                dir('selenium-tests') {
                    sh """
                        chmod +x ./mvnw
                        ./mvnw test \
                            -Dtarget.base.url=http://${CONTAINER_NAME}:8080 \
                            -Dselenium.grid.url=${SELENIUM_GRID_URL}
                    """
                }
            }
            post {
                always {
                    junit testResults: 'selenium-tests/target/surefire-reports/*.xml', allowEmptyResults: false
                    archiveArtifacts artifacts: 'selenium-tests/target/screenshots/*.png', allowEmptyArchive: true
                }
                failure {
                    echo "=================================================="
                    echo " GATE FAILURE: Selenium browser tests failed!"
                    echo " Diagnostic screenshots archived in Jenkins."
                    echo " Candidate deployment rejected."
                    echo "=================================================="
                }
            }
        }

        stage('Stage 7: Final Result') {
            steps {
                echo "=================================================="
                echo " [STAGE 7] All Quality Gates & Tests Verified"
                echo " Candidate image: ${IMAGE_NAME} ready for promotion."
                echo "=================================================="
                script {
                    echo "Build SUCCESS: Image ${IMAGE_NAME} passed unit, packaging, health, and browser validation."
                }
            }
        }
    }

    post {
        always {
            echo "Cleaning up temporary candidate container ${CONTAINER_NAME}..."
            sh "docker rm -f ${CONTAINER_NAME} || true"
        }
        success {
            echo "CI/CD Pipeline executed successfully."
        }
        failure {
            echo "Pipeline run completed with status FAILED. Consult JUnit reports and logs."
        }
    }
}
